# ==========================================
# NodeConnect — конфигурация
# Скопируйте этот файл в .env и заполните:
#   cp .env.example .env
# ==========================================

# Telegram бот
BOT_TOKEN="YOUR_BOT_TOKEN"
ADMIN_IDS=[YOUR_TELEGRAM_ID]
REQUIRED_CHANNEL_ID=0
CHANNEL_URL="https://t.me/your_channel"

# Marzban VPN API (используется ботом И сайтом)
MARZBAN_URL="https://panel.yourdomain.com"
MARZBAN_USERNAME="admin"
MARZBAN_PASSWORD="YOUR_MARZBAN_PASSWORD"
MARIADB_PASSWORD="marzban_password"
MARZBAN_DB_URL="mysql+aiomysql://marzban:marzban_password@mariadb:3306/marzban"

# PostgreSQL — строка для бота (asyncpg)
DB_URL="postgresql+asyncpg://nodeconnect:YOUR_DB_PASSWORD@postgres:5432/nodeconnect"

# PostgreSQL — для Docker контейнера (создаёт БД при первом запуске)
POSTGRES_DB=nodeconnect
POSTGRES_USER=nodeconnect
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# PostgreSQL — для сайта (psycopg2, отдельные поля)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nodeconnect
DB_USER=nodeconnect
DB_PASSWORD=YOUR_DB_PASSWORD

# Платежные системы
PLATEGA_API_KEY="YOUR_PLATEGA_API_KEY"
PLATEGA_SHOP_ID="YOUR_PLATEGA_SHOP_ID"
CRYPTO_BOT_TOKEN="YOUR_CRYPTOBOT_TOKEN"

# Курс конвертации RUB → USDT (обновлять по необходимости)
USDT_RATE=90.0

# Сайт — URL для возврата после оплаты и email админа
SITE_URL="https://yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"
